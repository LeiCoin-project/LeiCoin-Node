{
	"name": "advena-node",
	"version": "0.7.0",
	"description": "",
	"exports": "./src/index.ts",
	"type": "module",
	"scripts": {
		"setup": "bun run ./scripts/setup",
		"clean": "rm -rf node_modules",
		"test": "bun test",
		"typecheck": "tsc -p ./tsconfig/tsconfig.typecheck.json",
		"testnet": "bun run ./testnet",
		"debug": "bun run ./src/index.ts",
		"debug:bundle": "bun run ./build/bundle/advena-node.js",
		"debug:newBundle": "bun run ./scripts/bundle && bun run ./build/bundle/advena-node.js",
		"debug:noCompact": "bun run ./build/src",
		"debug:noCompactNewTsc": "tsc && bun run build/src",
		"bundle": "bun run ./scripts/bundle",
		"compile": "bun run ./scripts/compile",
		"release": "bun run ./scripts/build/withEntryPoint",
		"start": "./build/bin/advena-node"
	},
	"workspaces": [
		"src/*"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ADVENA-project/LeiCoin-Node.git"
	},
